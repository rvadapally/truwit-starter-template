---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import '../styles/theme-variables.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title = 'TruWit — Where Provenance Meets Proof', description = 'TruWit attaches cryptographic provenance, consent and authenticity to digital media so creators can sign and audiences can verify with confidence.', ogImage = '/images/og-truwit.png' } = Astro.props;

// Global constants
const siteTitle = 'Truwit — Where Provenance Meets Proof';
const siteDesc = 'Truwit attaches cryptographic provenance, consent, and authenticity to digital media.';
const siteUrl = 'https://truwit.ai';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon-truwit.svg" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="generator" content={Astro.generator} />

<!-- Theme initialization to prevent FOUC -->
<script is:inline>
  (function() {
    const theme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

<!-- Client-side rescue for /app/t/* deep links: redirect to hash routing -->
<script is:inline>
  (function() {
    try {
      var p = location.pathname;
      if (p.startsWith('/app/t/')) {
        var rest = p.substring(4); // '/t/...' including leading slash after /app
        var target = '/app/#' + rest + location.search + location.hash;
        location.replace(target);
      } else if (p === '/app' || p === '/app/') {
        // Ensure Angular boot even if cached HTML was served
        // No-op; Angular index will load under /app/
      }
    } catch (e) { /* ignore */ }
  })();
  </script>

<!-- Font preloads -->
<link rel="preload" href="/fonts/Inter-Var.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
<meta name="twitter:site" content="@TruwitAi" />

<!-- Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Truwit",
  "url": "https://truwit.ai",
  "logo": "https://truwit.ai/images/og-truwit.png",
  "sameAs": [
    "https://x.com/TruwitAi"
  ],
  "description": "Truwit attaches cryptographic provenance, consent, and authenticity to digital media."
}
</script>
