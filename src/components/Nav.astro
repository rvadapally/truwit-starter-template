---
const links = [
  { href:'/', label:'Home' },
  { href:'/how-it-works', label:'How It Works' },
  { href:'/use-cases', label:'Use Cases' },
  { href:'/technology', label:'Technology' },
  { href:'/pricing', label:'Pricing' },
  { href:'/investors', label:'Investors' },
];
---
<nav style="background:#0A1218;border-bottom:1px solid #14202A">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:#D9E6EE;font-weight:700">
      <img src="/favicon-truwit.svg" alt="T" width="22" height="22"/> TruWit
    </a>
    <div style="display:flex;gap:18px;align-items:center">
      {links.map(l => <a href={l.href}>{l.label}</a>)}
      <a class="btn" href="/app">Launch App</a>
    </div>
  </div>
</nav>