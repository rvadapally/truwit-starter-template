---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="Truwit — Where Provenance Meets Proof" description="The cryptographic verification layer for digital media." />
  </head>
  <body>
    <Nav />
    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <h1>Where Provenance Meets Proof</h1>
          <p class="hero-subtitle">The cryptographic verification layer for the AI age</p>
          <div class="cta-group">
            <a href="/app/" class="btn btn-primary">Try Verification App</a>
            <a href="/how-it-works" class="btn btn-secondary">See How It Works</a>
            <a href="/investors" class="btn btn-secondary">For Investors</a>
          </div>
        </div>
      </section>

      <!-- Problem Section -->
      <section class="section">
        <div class="container">
          <h2>The AI Content Crisis</h2>
          <p class="section-subtitle">Trust is broken. Truwit fixes it.</p>
          <div class="stats">
            <div class="stat">
              <div class="stat-value">90%</div>
              <div class="stat-label">of online content will be AI-generated by 2026</div>
            </div>
            <div class="stat">
              <div class="stat-value">900%</div>
              <div class="stat-label">increase in deepfakes in 2024</div>
            </div>
            <div class="stat">
              <div class="stat-value">73%</div>
              <div class="stat-label">of users can't identify AI content</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Solution Section -->
      <section class="section bg-dark">
        <div class="container">
          <h2>How Truwit Works</h2>
          <p class="section-subtitle">Three simple steps to cryptographic proof</p>
          <div class="cards">
            <div class="card">
              <div class="card-icon">🔗</div>
              <h3>Verify</h3>
              <p>Upload or link to content, get cryptographic proof. Works with YouTube, TikTok, files, and more.</p>
            </div>
            <div class="card">
              <div class="card-icon">🔒</div>
              <h3>Trust</h3>
              <p>Immutable record secured with military-grade cryptography. C2PA compliant and future-proof.</p>
            </div>
            <div class="card">
              <div class="card-icon">✓</div>
              <h3>Share</h3>
              <p>Embeddable trust badges, public verification pages. Prove authenticity to anyone, anywhere.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="section cta-section">
        <div class="container text-center">
          <h2>Start Verifying Content Today</h2>
          <p class="section-subtitle">Free forever. No credit card required. Get started in 30 seconds.</p>
          <div class="cta-group">
            <a href="/app/" class="btn btn-primary">Try Verification App</a>
            <a href="/contact" class="btn btn-secondary">Talk to Our Team</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    background: #0b1220;
    color: #e6eefc;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    background: linear-gradient(135deg, #0A1929 0%, #1a2942 100%);
    padding: 4rem 0;
    text-align: center;
  }

  .hero h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #00D4FF, #00FFA3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }

  .section {
    padding: 4rem 0;
  }

  .section h2 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    text-align: center;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 3rem;
  }

  .bg-dark {
    background: #0A1929;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: linear-gradient(135deg, #00D4FF, #00FFA3);
    color: #0A1929;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
  }

  .btn-secondary:hover {
    background: white;
    color: #0A1929;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    text-align: center;
  }

  .stat {
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 0.5rem;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #00D4FF, #00FFA3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .card {
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 0.5rem;
    transition: transform 0.2s;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .card p {
    color: rgba(255, 255, 255, 0.7);
  }

  .text-center {
    text-align: center;
  }

  .cta-section {
    background: linear-gradient(135deg, #0A1929 0%, #1a2942 100%);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }
    
    .section h2 {
      font-size: 2rem;
    }
  }
</style>
