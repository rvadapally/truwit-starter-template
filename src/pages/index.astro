---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="en">
  <BaseHead
    title="TruWit — Where Provenance Meets Proof"
    description="The cryptographic verification layer for the AI age. Sign your media and verify origin in seconds."
    ogImage="/images/og-truwit.png"
  />
  <body>
    <Header />

    <!-- Above-the-fold hero -->
    <section class="hero">
      <div class="container">
        <h1 class="hero-title">
          Where <span class="accent">Provenance</span> Meets Proof
        </h1>
        <p class="hero-subtitle">
          Cryptographic verification for digital content. 
          Attach provenance, consent, and authenticity to every file.
        </p>
        <div class="hero-badges">
          <img src="/assets/verified-circular-badge.jpg" alt="Verified" class="badge-icon" />
          <span class="badge-text">Every verification is cryptographically signed</span>
        </div>
        <div class="hero-actions">
          <a href="/app/#/verify" class="btn-primary">Start Verification</a>
          <a href="/how-it-works" class="btn-secondary">How It Works</a>
        </div>
      </div>
    </section>

      <!-- New compact hero card grid -->
      <div class="home-hero">
        <div class="home-grid">
          <!-- LEFT: How TruWit Works -->
          <div>
            <div class="kicker">HOW TRUWIT WORKS</div>
            <h2 style="margin-bottom:6px">Three steps, one proof</h2>
            <p class="muted">Make origin and consent obvious — without oversharing your data or files.</p>

            <div class="step-list">
              <div class="step">
                <div class="ico">🔗</div>
                <div>
                  <strong>1) Verify</strong>
                  <p class="small">Paste a link or upload a file. TruWit accepts popular video and image formats.</p>
                </div>
              </div>
              <div class="step">
                <div class="ico">🔐</div>
                <div>
                  <strong>2) Trust</strong>
                  <p class="small">We generate a proprietary cryptographic fingerprint bound to origin-defining attributes.</p>
                </div>
              </div>
              <div class="step">
                <div class="ico">✅</div>
                <div>
                  <strong>3) Share</strong>
                  <p class="small">Publish with "Signed" / "Verified" badges and a downloadable, public-safe manifest.</p>
                </div>
              </div>
            </div>

            <!-- micro stats strip fills space neatly on left -->
            <div class="mini-strip">
              <div class="stat-row" style="flex:1">
                <div class="stat"><h3>90%</h3><div class="small">AI content by 2026</div></div>
                <div class="stat"><h3>900%</h3><div class="small">deepfake increase</div></div>
                <div class="stat"><h3>73%</h3><div class="small">can't identify AI</div></div>
              </div>
            </div>
          </div>

          <!-- RIGHT: Action cards (no dead space) -->
          <div class="action-cards">
            <div class="action-card">
              <div class="kicker">VERIFY</div>
              <h3>Check a link or file</h3>
              <p class="small">Instant status: Valid • Derived • Mismatch. No login needed.</p>
              <div class="hr"></div>
              <a class="btn" href="/app">Start Verification</a>
            </div>
            <div class="action-card">
              <div class="kicker">SIGN</div>
              <h3>Create a proof</h3>
              <p class="small">Free for creators during early access. Keep attribution and consent attached.</p>
              <div class="hr"></div>
              <a class="btn" href="/app">Generate Proof</a>
            </div>
            <div class="action-card">
              <div class="kicker">BADGES</div>
              <h3>Show trust, anywhere</h3>
              <p class="small">Use "Verified by TruWit" and "Signed with TruWit" patches on posts, thumbnails, and sites.</p>
              <div class="hr"></div>
              <div class="badges">
                <img src="/images/verified-circular-badge.jpg" alt="Verified" style="width:80px;height:80px" />
                <img src="/images/verified-circular-badge.jpg" alt="Signed" style="width:80px;height:80px" />
              </div>
            </div>
          </div>
        </div>

        <!-- Demo + reassurance row (fills horizontal space under grid) -->
        <div class="mini-strip">
          <div class="badges">
            <span class="note">Public-safe • Privacy by default • Interoperable manifest</span>
          </div>
          <div>
            <a class="btn secondary" href="/technology">Product Overview</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA band -->
    <section class="container center">
      <div class="card">
        <h2>Start verifying content today</h2>
        <p class="muted">Free for creators during early access. No credit card required.</p>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:10px">
          <a class="btn" href="/app">Launch App</a>
          <a class="btn secondary" href="/contact">Contact Us</a>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-primary);
    text-align: center;
    padding: 2rem 0;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .hero-title .accent {
    color: var(--color-accent-primary);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0;
  }

  .badge-icon {
    width: 48px;
    height: 48px;
    filter: drop-shadow(var(--shadow-glow));
  }

  .badge-text {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-primary {
    background: var(--color-accent-primary);
    color: var(--color-bg-primary);
    padding: 12px 32px;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition-fast);
    text-decoration: none;
    display: inline-block;
    font-family: var(--font-primary);
    font-size: 1rem;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text-primary);
    border: 2px solid rgba(255, 255, 255, 0.25);
    padding: 10px 30px;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-fast);
    text-decoration: none;
    display: inline-block;
    font-family: var(--font-primary);
    font-size: 1rem;
  }

  .btn-secondary:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
    
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
    
    .hero-badges {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>