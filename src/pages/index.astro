---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="Truwit — Where Provenance Meets Proof" description="The cryptographic verification layer for digital media." />
  </head>
  <body>
    <Nav />
    <main>
      <!-- Compact Hero Section -->
      <section class="hero-compact">
        <div class="container">
          <h1>Where Provenance Meets Proof</h1>
          <p class="hero-subtitle">The cryptographic verification layer for the AI age</p>
          <div class="cta-group">
            <a href="/app/" class="btn btn-primary">Try Verification App</a>
            <a href="/how-it-works" class="btn btn-secondary">How It Works</a>
            <a href="/investors" class="btn btn-secondary">Investors</a>
          </div>
        </div>
      </section>

      <!-- Combined Problem + Solution Section (Side by Side on Desktop) -->
      <section class="section-combined">
        <div class="container">
          <div class="two-column">
            <!-- Left: Problem -->
            <div class="column">
              <h2>The AI Content Crisis</h2>
              <p class="subtitle">Trust is broken. Truwit fixes it.</p>
              <div class="stats-compact">
                <div class="stat-compact">
                  <div class="stat-value">90%</div>
                  <div class="stat-label">AI content by 2026</div>
                </div>
                <div class="stat-compact">
                  <div class="stat-value">900%</div>
                  <div class="stat-label">deepfake increase</div>
                </div>
                <div class="stat-compact">
                  <div class="stat-value">73%</div>
                  <div class="stat-label">can't identify AI</div>
                </div>
              </div>
            </div>

            <!-- Right: Solution -->
            <div class="column">
              <h2>How Truwit Works</h2>
              <p class="subtitle">Three simple steps</p>
              <div class="steps-compact">
                <div class="step">
                  <span class="step-icon">🔗</span>
                  <div>
                    <h3>1. Verify</h3>
                    <p>Upload or link content</p>
                  </div>
                </div>
                <div class="step">
                  <span class="step-icon">🔒</span>
                  <div>
                    <h3>2. Trust</h3>
                    <p>Cryptographic proof created</p>
                  </div>
                </div>
                <div class="step">
                  <span class="step-icon">✓</span>
                  <div>
                    <h3>3. Share</h3>
                    <p>Embeddable trust badges</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Compact CTA Section -->
      <section class="cta-compact">
        <div class="container">
          <div class="cta-content">
            <div>
              <h2>Start Verifying Content Today</h2>
              <p>Free forever. No credit card required.</p>
            </div>
            <div class="cta-buttons">
              <a href="/app/" class="btn btn-primary">Try App</a>
              <a href="/contact" class="btn btn-secondary">Contact Us</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    background: #0b1220;
    color: #e6eefc;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Compact Hero */
  .hero-compact {
    background: linear-gradient(135deg, #0A1929 0%, #1a2942 100%);
    padding: 3rem 0;
    text-align: center;
  }

  .hero-compact h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, #00D4FF, #00FFA3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.5rem;
  }

  /* Two Column Layout for Desktop */
  .section-combined {
    padding: 3rem 0;
    background: #0A1929;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .column h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
  }

  /* Compact Stats - Horizontal */
  .stats-compact {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-compact {
    flex: 1;
    min-width: 120px;
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 0.5rem;
    text-align: center;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #00D4FF, #00FFA3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
  }

  /* Compact Steps - Vertical but tighter */
  .steps-compact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 0.5rem;
  }

  .step-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .step h3 {
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .step p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Compact CTA - Horizontal */
  .cta-compact {
    background: linear-gradient(135deg, #0A1929 0%, #1a2942 100%);
    padding: 2.5rem 0;
  }

  .cta-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .cta-content h2 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-primary {
    background: linear-gradient(135deg, #00D4FF, #00FFA3);
    color: #0A1929;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
  }

  /* Mobile Responsive - Stack Vertically */
  @media (max-width: 968px) {
    .two-column {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .cta-content {
      flex-direction: column;
      text-align: center;
    }

    .cta-buttons {
      width: 100%;
      justify-content: center;
    }

    .container {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .hero-compact h1 {
      font-size: 2rem;
    }

    .column h2 {
      font-size: 1.5rem;
    }

    .stats-compact {
      flex-direction: column;
    }

    .stat-compact {
      width: 100%;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      font-size: 0.95rem;
    }

    .hero-compact {
      padding: 2rem 0;
    }

    .section-combined {
      padding: 2rem 0;
    }

    .cta-compact {
      padding: 2rem 0;
    }
  }
</style>
