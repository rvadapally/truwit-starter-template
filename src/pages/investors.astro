---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<html lang="en">
<head><BaseHead title="For Investors - Truwit" description="Investing in digital truth" /></head>
<body>
<Nav />
<main>
<section class="hero"><div class="container">
<h1>Investing in Digital Truth</h1>
<p class="subtitle">The infrastructure layer for content authenticity</p>
</div></section>
<section class="section"><div class="container">
<h2>The Market Opportunity</h2>
<div class="stats">
<div class="stat"><div class="stat-value">$78B</div><div class="stat-label">Lost to deepfake fraud in 2024</div></div>
<div class="stat"><div class="stat-value">90%</div><div class="stat-label">Of online content will be AI-generated by 2026</div></div>
<div class="stat"><div class="stat-value">Zero</div><div class="stat-label">Reliable verification infrastructure at scale</div></div>
</div>
</div></section>
<section class="section bg-dark"><div class="container text-center">
<h2>Let's Build the Future</h2>
<p>Open to strategic investors who understand the importance of digital truth in the AI age.</p>
<div class="cta-group">
<a href="/contact" class="btn btn-primary">Schedule a Call</a>
<a href="mailto:investors@truwit.ai" class="btn btn-secondary">investors@truwit.ai</a>
</div>
</div></section>
</main>
<Footer />
</body>
</html>
<style>
body{font-family:sans-serif;background:#0b1220;color:#e6eefc;margin:0}
.container{max-width:1200px;margin:0 auto;padding:0 1.5rem}
.hero{background:linear-gradient(135deg,#0A1929,#1a2942);padding:4rem 0;text-align:center}
.hero h1{font-size:3rem;font-weight:700;margin-bottom:1rem;background:linear-gradient(135deg,#00D4FF,#00FFA3);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.subtitle{font-size:1.25rem;color:rgba(255,255,255,0.8)}
.section{padding:4rem 0}
.section h2{font-size:2.5rem;text-align:center;margin-bottom:2rem}
.bg-dark{background:#0A1929}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem;text-align:center}
.stat{background:rgba(255,255,255,0.05);padding:2rem;border-radius:0.5rem}
.stat-value{font-size:2.5rem;font-weight:700;background:linear-gradient(135deg,#00D4FF,#00FFA3);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:0.5rem}
.stat-label{color:rgba(255,255,255,0.7);font-size:0.875rem}
.cta-group{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem}
.btn{display:inline-block;padding:1rem 2rem;border-radius:0.5rem;font-weight:600;text-decoration:none;transition:all 0.2s}
.btn-primary{background:linear-gradient(135deg,#00D4FF,#00FFA3);color:#0A1929}
.btn-secondary{background:transparent;color:white;border:2px solid white}
.text-center{text-align:center}
</style>
