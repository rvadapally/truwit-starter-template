---
import BaseHead from '../components/BaseHead.astro';
import Section from '../components/Section.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';
---
<html lang="en">
  <BaseHead title="TruWit Technology — Secure proofs without oversharing secrets" />
  <body>
    <Section kicker="UNDER THE HOOD" title="Technology">
      <div class="grid-3">
        <FeatureCard icon="🧩" title="Proof-of-origin" body="Each asset receives a compact digital fingerprint bound to platform and media attributes that define origin."/>
        <FeatureCard icon="🛡️" title="Privacy by default" body="We avoid collecting unnecessary personal data. Proofs are public-safe and keep sensitive details private."/>
        <FeatureCard icon="🔏" title="Tamper awareness" body="If content is altered or relinked, verification reflects that status clearly (valid, derived, or mismatch)."/>
      </div>
      <div class="hr"></div>
      <div class="grid-2">
        <div class="card">
          <h3>Interoperability</h3>
          <p>TruWit provides a machine-readable manifest and a human summary so teams can archive proofs and automate checks.</p>
        </div>
        <div class="card">
          <h3>Roadmap</h3>
          <p>Expanding platform coverage and enterprise tooling while maintaining a principled, platform-friendly approach.</p>
        </div>
      </div>
    </Section>
    <CTA title="Build trust into your media" />
  </body>
</html>