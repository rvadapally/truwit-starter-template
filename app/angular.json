{
  "$schema": "https://json.schemastore.org/angular.json",
  "version": 1,
  "projects": {
    "humanproof-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/humanproof-web/browser",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/_redirects"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "baseHref": "/"
          },
          "configurations": {
            "production": {
              "baseHref": "/",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "humanproof-web:build",
            "disableHostCheck": true,
            "liveReload": true,
            "watch": true,
            "poll": 1000
          },
          "configurations": {
            "production": {
              "buildTarget": "humanproof-web:build:production"
            }
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/humanproof-web/server",
            "main": "server.ts",
            "tsConfig": "tsconfig.server.json",
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": {
              "outputHashing": "media",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-ssr": {
          "builder": "@angular-devkit/build-angular:ssr-dev-server",
          "configurations": {
            "development": {
              "browserTarget": "humanproof-web:build:development",
              "serverTarget": "humanproof-web:server:development"
            },
            "production": {
              "browserTarget": "humanproof-web:build:production",
              "serverTarget": "humanproof-web:server:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "builder": "@angular-devkit/build-angular:prerender",
          "options": {
            "routes": [
              "/",
              "/how-it-works",
              "/use-cases",
              "/technology",
              "/products",
              "/truviz",
              "/audit",
              "/pricing",
              "/investors",
              "/verify",
              "/legal/privacy",
              "/legal/terms"
            ]
          },
          "configurations": {
            "production": {
              "browserTarget": "humanproof-web:build:production",
              "serverTarget": "humanproof-web:server:production"
            },
            "development": {
              "browserTarget": "humanproof-web:build:development",
              "serverTarget": "humanproof-web:server:development"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "3887381b-a1a3-4e74-8311-5ce659058d39"
  }
}